# ─────────────────────────────────────────────────────────────
# Pavani Realty - environment variables
# Copy to .env.local for local dev, and set the SAME values in
# Vercel → Project → Settings → Environment Variables (all environments).
# ─────────────────────────────────────────────────────────────

# Sanity project - MUST be the Pavani project (b9pxg5gg), NOT Kaara (msvji5g0)
NEXT_PUBLIC_SANITY_PROJECT_ID=b9pxg5gg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-29

# Read token (role: Viewer or higher) - fetches published content
SANITY_API_READ_TOKEN=

# Write token (role: Editor) - required to SAVE article comments
SANITY_API_WRITE_TOKEN=

# Email (Mailtrap) for newsletter notifications
MAILTRAP_API_KEY=
# Optional: where new-subscriber alerts are sent (defaults to pavanirealtyco@gmail.com)
NEWSLETTER_NOTIFY_EMAIL=

# Mapping - open-source CartoDB tiles are used (no key needed).
# Only set these if you switch to Mapbox/Google Maps.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
